# Local Edge Function secrets only. Copy to `supabase/functions/.env`.
# Never commit the real values and never put them in the Flutter root .env
# (that file is bundled into the app).
# Google Gemini (optional, tried before OpenRouter). Key from aistudio.google.com.
GEMINI_API_KEY=replace-with-gemini-key
# Ordered list; a model that runs out of quota is skipped for a while.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-4-carbon,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.1-pro-preview,gemini-2.5-flash-lite

OPENROUTER_API_KEY=replace-with-server-secret
# Ordered fallback list; the first model that answers wins.
OPENROUTER_MODELS=nvidia/nemotron-3.5-super-vl:free,baidu/ernie-5.5-flash-preview:free,google/gemma-4-31b-it:free

# Server-to-server mirror (mirror-sync). Values of the OTHER project.
MIRROR_SUPABASE_URL=https://other-project-id.supabase.co
MIRROR_SERVICE_ROLE_KEY=replace-with-other-project-secret-key
MIRROR_CRON_SECRET=replace-with-long-random-string
MIRROR_TARGET_NAME=secondary

# SePay webhook (sepay-webhook). Same value as the API Key set on SePay.
SEPAY_API_KEY=replace-with-long-random-string

# Support chat e-mail relay (support-notify).
RESEND_API_KEY=replace-with-resend-key
SUPPORT_INBOX=replace-with-your-inbox
