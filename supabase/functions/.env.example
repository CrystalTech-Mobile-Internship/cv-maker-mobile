# Local Edge Function secrets only. Copy to `supabase/functions/.env`.
# Never commit the real values and never put them in the Flutter root .env
# (that file is bundled into the app).
OPENROUTER_API_KEY=replace-with-server-secret
# Ordered fallback list; the first model that answers wins.
OPENROUTER_MODELS=nvidia/nemotron-3.5-super-vl:free,baidu/ernie-5.5-flash-preview:free,google/gemma-4-31b-it:free
