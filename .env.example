# ==============================================================================
# SMART CV MAKER MOBILE - ENVIRONMENT VARIABLES TEMPLATE
# Copy file này thành `.env` trên máy cá nhân và điền thông tin thực tế:
#   cp .env.example .env
#
# LƯU Ý BẢO MẬT:
# - File `.env` chứa khóa thật ĐÃ ĐƯỢC CHẶN trong .gitignore, KHÔNG COMMIT LÊN GITHUB!
# - File `.env.example` này chỉ chứa giá trị mẫu/placeholder, hoàn toàn an toàn để commit.
# ==============================================================================

# Supabase Configuration
# Lấy từ: Supabase Dashboard -> Project Settings -> Data API
# Chỉ một profile được dùng trong mỗi lần chạy ứng dụng. Không tự đổi profile
# khi người dùng đang đăng nhập vì Auth/JWT/database của hai project tách biệt.
SUPABASE_ACTIVE_PROFILE=primary
SUPABASE_PRIMARY_URL=https://your-primary-project-id.supabase.co
SUPABASE_PRIMARY_ANON_KEY=sb_publishable_your-primary-key-here
SUPABASE_SECONDARY_URL=https://your-secondary-project-id.supabase.co
SUPABASE_SECONDARY_ANON_KEY=sb_publishable_your-secondary-key-here

# Bản thân Supabase thiết kế publishable/anon key để nhúng vào web/mobile app.
# Tính an toàn bảo vệ dữ liệu CV của người dùng nằm ở RLS (Row-Level Security) 
# trên Database Supabase (Phong thiết lập). Kẻ xấu dù có decompile lấy được anon key 
# cũng không thể đọc trộm hay sửa CV của người khác được. (Chỉ có service_role key mới là chìa khóa vạn năng, cấm tuyệt đối không đưa vào app).


# Google Gemini AI Configuration
# Lấy từ: Google AI Studio (https://aistudio.google.com/) -> Get API Key
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere 

# Fallback AI (Tùy chọn - Groq Cloud / Llama 3.3 tốc độ cao)
# Lấy từ: https://console.groq.com/keys
GROQ_API_KEY=gsk_yourGroqApiKeyHere

# - Giai đoạn Thực tập / Dev / Demo: Dùng key cá nhân free từ Google AI Studio 
#      trong .env để phát triển rất nhanh và tiện lợi.
# - Khi phát hành Production thật: Có 2 cách bảo vệ:
# 1. Vào Google Cloud Console giới hạn key chỉ cho phép App 
#   có đúng Package Name + chữ ký SHA-1 của app bạn gọi.
# 2. Hoặc gọi AI thông qua Supabase Edge Function (API trung gian),
#   khi đó key AI nằm 100% trên Server chứ không nằm trong file APK.
